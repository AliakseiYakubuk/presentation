    "sameAs": [
      "https://www.linkedin.com/in/johndoe/",
      "https://github.com/johndoe"
    ],

    "knowsAbout": [
      "JavaScript",
      "TypeScript",
      "React",
      "Node.js",
      "Cloud Computing",
      "Distributed Systems"
    ]
  }
}
</script>
