		"yarn": ">=1.22.4",
		"node": ">=24.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/node": "25.9.1",
		"husky": "9.1.7",
		"postcss": "8.5.23",
		"sass": "1.100.0",
		"typescript": "6.0.3",
		"vite": "6.4.5",
		"vite-plugin-html": "3.2.2",
		"vite-plugin-static-copy": "4.1.0"
	},
	"resolutions": {
		"brace-expansion": "2.1.7",
		"source-map-js": "1.2.2",
		"immutable": "5.1.8",
		"postcss": "8.5.23",
		"nanoid": "3.3.18"
